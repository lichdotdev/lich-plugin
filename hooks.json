{
  "lich": {
    "PreInvocation": [
      {
        "type": "command",
        "command": "hooks/report-session-start.sh antigravity; printf '{}'",
        "timeout": 5
      },
      {
        "type": "command",
        "command": "hooks/report-state.sh busy; printf '{}'",
        "timeout": 5
      },
      {
        "type": "command",
        "command": "hooks/report-title.sh once; printf '{}'",
        "timeout": 5
      },
      {
        "type": "command",
        "command": "hooks/report-touched.sh collect",
        "timeout": 5
      }
    ],
    "PreToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "payload=$(cat); printf '%s' \"$payload\" | hooks/report-tool.sh; printf '%s' \"$payload\" | hooks/veto-subagent.sh antigravity || printf '{\"decision\":\"allow\"}'",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "write_file|edit_file|write_to_file|replace_file_content|run_command",
        "hooks": [
          {
            "type": "command",
            "command": "hooks/report-touched.sh hold; printf '{}'",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "hooks/report-state.sh done; printf '{\"decision\":\"\"}'",
        "timeout": 5
      },
      {
        "type": "command",
        "command": "hooks/report-title.sh; printf '{\"decision\":\"\"}'",
        "timeout": 5
      }
    ]
  }
}
