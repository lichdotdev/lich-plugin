{
  "hooks": {
    "PreToolUse": [
      {
        "name": "lich session id",
        "command": "\"<lich-plugin>/hooks/report-session-start.sh\" crush",
        "timeout": 5
      },
      {
        "name": "lich git-status refresh",
        "matcher": "^(edit|write|multiedit|bash)$",
        "command": "\"<lich-plugin>/hooks/report-touched.sh\"",
        "timeout": 5
      },
      {
        "name": "lich subagent cards",
        "matcher": "^agent$",
        "command": "\"<lich-plugin>/hooks/veto-subagent.sh\" crush",
        "timeout": 15
      }
    ]
  }
}
